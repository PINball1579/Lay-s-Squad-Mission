# Local-only defaults. Replace every secret for any shared or deployed environment.
POSTGRES_DB=crunch_squad
POSTGRES_USER=crunch
POSTGRES_PASSWORD=crunch-local-only
MOCK_LIFF=true
CAMPAIGN_ID=demo-campaign
ALLOWED_ORIGIN=http://localhost:5173
SECURE_COOKIES=false
QR_SIGNING_SECRET=local-qr-signing-key-change-me-32-byte
PSEUDONYM_KEY=local-pseudonym-key-change-me-32-bytes
ADMIN_API_TOKEN=local-admin-demo-token

# Required only for real LIFF mode.
VITE_LIFF_ID=
LINE_CHANNEL_ID=
# Messaging API token for completion cards, from the linked Official Account.
LINE_CHANNEL_ACCESS_TOKEN=
IAPP_API_KEY=
IAPP_OCR_ENDPOINT=https://api.iapp.co.th/v3/store/ocr/document/ocr
# Optional HTTPS share image override; defaults to the hosted campaign image.
VITE_SHARE_IMAGE_URL=

